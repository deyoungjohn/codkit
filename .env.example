# Copy to .env (git-ignored). TESTNET-ONLY keys. Never put a mainnet key here.

# --- Deploying contracts (your wallet) ---
# Recommended: a Foundry keystore instead of a raw key:
#   cast wallet import deployer --interactive    then:  pnpm deploy:evm --network base-sepolia --account deployer --verify
# Alternative (non-interactive, e.g. CI): a testnet-only deployer key
DEPLOYER_PRIVATE_KEY=
# Source verification on Basescan/Etherscan (one Etherscan v2 key covers all chains). Without it, Sourcify is used.
ETHERSCAN_API_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Running the agent / e2e checks ---
# The "agent" wallet: needs ~0.002 ETH + ~0.15 USDC on Base Sepolia (https://faucet.circle.com)
AGENT_PRIVATE_KEY=
# Optional: a fixed provider wallet instead of a fresh one per run
PROVIDER_PRIVATE_KEY=
# Sui: suiprivkey… (sui keytool export --key-identity <address>). Optional: defaults to the Sui CLI active address.
SUI_PRIVATE_KEY=

# --- LLM for the agent loop (any OpenAI-compatible provider; no Anthropic API) ---
# Set one or more keys. With several, they form a failover chain in this order:
# groq → gemini → nvidia → openrouter → agentrouter (or set LLM_PROVIDER=gemini,groq to choose).
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
AGENTROUTER_API_KEY=
# Optional model overrides (list them: pnpm --filter @codkit/mcp example:models)
LLM_MODEL=
# GROQ_MODEL= GEMINI_MODEL= NVIDIA_MODEL= OPENROUTER_MODEL= AGENTROUTER_MODEL=
# Any other OpenAI-compatible endpoint (Ollama, vLLM, LM Studio…): LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=

# --- Examples / dashboard ---
EVM_PRIVATE_KEY=
EVM_RPC_URL=https://sepolia.base.org
PAY_TO=
X402_FACILITATOR_URL=https://x402.org/facilitator
RECEIPT_KEY=

# --- Dashboard auth (apps/demo-shell) ---
# Operator password; required in production (the dashboard stays locked without it).
DASHBOARD_PASSWORD=
# Optional, >= 32 chars: signs session cookies (defaults to a key derived from the password).
SESSION_SECRET=
# Optional, >= 16 chars: enables the bearer-protected MCP endpoint at /api/mcp.
MCP_TOKEN=
