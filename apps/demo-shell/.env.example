# Optional. Without an LLM key the dashboard runs a scripted demo agent through
# the real policy engine, x402 paywall and receipt log. With one, the LLM drives.
# Several keys form a failover chain (free tiers rate-limit). See ../../.env.example.
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
AGENTROUTER_API_KEY=
LLM_MODEL=
# Optional: persist the receipt signing key between restarts (hex ed25519 secret).
RECEIPT_KEY=
