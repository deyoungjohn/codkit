{
  "name": "example-dapp-vite",
  "private": true,
  "type": "module",
  "description": "Smallest dapp on @codkit/wallet + @codkit/ui: connect EVM and Solana wallets, sign, send a testnet transfer.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "e2e": "tsx --env-file-if-exists=../../.env e2e/run.ts",
    "e2e:picker": "tsx e2e/picker.ts"
  },
  "dependencies": {
    "@codkit/config": "workspace:*",
    "@codkit/ui": "workspace:*",
    "@codkit/wallet": "workspace:*",
    "@solana-program/system": "^0.15.0",
    "@solana/kit": "^8.0.0",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.20",
    "wagmi": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "~1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
