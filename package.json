{
  "name": "codkit",
  "private": true,
  "description": "Reusable plumbing for Web3 / AI agent hackathon projects: policy guardrails, x402 payments, escrow, receipts, MCP, demo shell.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "deploy:evm": "pnpm --filter @codkit/contracts run deploy:evm",
    "deploy:sui": "pnpm --filter @codkit/contracts run deploy:sui",
    "e2e:evm": "pnpm --filter testnet-e2e run evm",
    "e2e:sui": "pnpm --filter testnet-e2e run sui",
    "e2e:solana": "pnpm --filter testnet-e2e run solana",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "^22.13.0",
    "tsx": "^4.21.0",
    "turbo": "^2.11.8",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
