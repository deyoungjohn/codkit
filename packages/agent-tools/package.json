{
  "name": "@codkit/agent-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Tools an AI agent can use to read balances, send tokens and swap on EVM and Solana, behind per-call caps, dry-run and @codkit/policy. Runs in the Vercel AI SDK and MCP.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "author": "Young John",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deyoungjohn/codkit.git",
    "directory": "packages/agent-tools"
  },
  "homepage": "https://github.com/deyoungjohn/codkit/tree/main/packages/agent-tools#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./evm": {
      "import": {
        "types": "./dist/evm.d.ts",
        "default": "./dist/evm.js"
      },
      "require": {
        "types": "./dist/evm.d.cts",
        "default": "./dist/evm.cjs"
      }
    },
    "./uniswap": {
      "import": {
        "types": "./dist/uniswap.d.ts",
        "default": "./dist/uniswap.js"
      },
      "require": {
        "types": "./dist/uniswap.d.cts",
        "default": "./dist/uniswap.cjs"
      }
    },
    "./lifi": {
      "import": {
        "types": "./dist/lifi.d.ts",
        "default": "./dist/lifi.js"
      },
      "require": {
        "types": "./dist/lifi.d.cts",
        "default": "./dist/lifi.cjs"
      }
    },
    "./solana": {
      "import": {
        "types": "./dist/solana.d.ts",
        "default": "./dist/solana.js"
      },
      "require": {
        "types": "./dist/solana.d.cts",
        "default": "./dist/solana.cjs"
      }
    },
    "./jupiter": {
      "import": {
        "types": "./dist/jupiter.d.ts",
        "default": "./dist/jupiter.js"
      },
      "require": {
        "types": "./dist/jupiter.d.cts",
        "default": "./dist/jupiter.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@codkit/config": "workspace:^",
    "@codkit/mcp": "workspace:^",
    "@codkit/policy": "workspace:^",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.0.0",
    "viem": "^2.48.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    },
    "@solana/kit": {
      "optional": true
    },
    "@solana-program/system": {
      "optional": true
    },
    "@solana-program/token": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana/kit": "^8.6.0",
    "ai": "^7.0.180",
    "viem": "^2.57.20"
  }
}
