{
  "name": "@codkit/config",
  "version": "0.1.0",
  "description": "Chain registry (EVM, Solana, Sui), RPC resolution with fallbacks and keyed providers, explorer links, and a typed env schema for dapps.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "author": "Young John",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deyoungjohn/codkit.git",
    "directory": "packages/config"
  },
  "homepage": "https://github.com/deyoungjohn/codkit/tree/main/packages/config#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./viem": {
      "import": {
        "types": "./dist/viem.d.ts",
        "default": "./dist/viem.js"
      },
      "require": {
        "types": "./dist/viem.d.cts",
        "default": "./dist/viem.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "gen": "node scripts/gen-evm.mjs",
    "example": "tsx --env-file-if-exists=../../.env examples/resolve.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "viem": "^2.48.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "viem": "^2.57.20"
  }
}
