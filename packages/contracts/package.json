{
  "name": "@codkit/contracts",
  "version": "0.1.0",
  "description": "Escrow (create \u2192 fund \u2192 deliver \u2192 release/refund) + reputation counter. Solidity (Foundry) with typed viem bindings that plug into @codkit/policy.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "author": "Young John",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deyoungjohn/codkit.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/deyoungjohn/codkit/tree/main/packages/contracts#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./evm": {
      "types": "./dist/evm/index.d.ts",
      "import": "./dist/evm/index.js"
    },
    "./sui": {
      "types": "./dist/sui/index.d.ts",
      "import": "./dist/sui/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "evm/src",
    "evm/script",
    "evm/foundry.toml",
    "sui/sources",
    "sui/Move.toml",
    "sui/Move.lock",
    "README.md",
    "deployments/*.json",
    "!deployments/*local*.json",
    "!deployments/anvil*.json",
    "deployments/README.md",
    "sui/Published.toml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:sol && pnpm run test:move && vitest run",
    "test:sol": "forge test --root evm",
    "abi": "forge build --root evm && node scripts/gen-abi.mjs",
    "clean": "rm -rf dist .turbo evm/out evm/cache",
    "example": "tsx --env-file-if-exists=../../.env examples/escrow-flow.ts",
    "example:sui": "tsx --env-file-if-exists=../../.env examples/sui-localnet.ts",
    "test:move": "sh -c \"command -v sui >/dev/null && cd sui && sui move test < /dev/null || echo \\\"sui CLI not found; skipping Move tests\\\"\"",
    "deployments": "node scripts/deployments-table.mjs",
    "deploy:evm": "node --env-file-if-exists=../../.env scripts/deploy-evm.mjs",
    "deploy:sui": "node --env-file-if-exists=../../.env scripts/deploy-sui.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "viem": "^2.48.0",
    "@mysten/sui": "^2.0.0",
    "@codkit/policy": "workspace:^"
  },
  "devDependencies": {
    "@codkit/policy": "workspace:*",
    "viem": "^2.48.0",
    "@mysten/sui": "^2.36.0"
  },
  "peerDependenciesMeta": {
    "@mysten/sui": {
      "optional": true
    },
    "viem": {
      "optional": true
    },
    "@codkit/policy": {
      "optional": true
    }
  }
}
