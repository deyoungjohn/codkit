{
  "name": "@codkit/feed",
  "version": "0.1.0",
  "description": "One live event stream for agent demos: policy decisions, tool calls, reasoning, transactions and receipts, served over Server-Sent Events.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "author": "Young John",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deyoungjohn/codkit.git",
    "directory": "packages/feed"
  },
  "homepage": "https://github.com/deyoungjohn/codkit/tree/main/packages/feed#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@codkit/receipts": "workspace:^"
  },
  "peerDependencies": {
    "@codkit/policy": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@codkit/policy": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codkit/policy": "workspace:*"
  }
}
