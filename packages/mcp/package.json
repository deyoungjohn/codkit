{
  "name": "@codkit/mcp",
  "version": "0.1.0",
  "description": "Define agent tools once with Zod; expose them as an MCP server (stdio / HTTP), a Claude tool-runner agent loop, and WebMCP browser tools. Ships kit tools for policy, x402 pay, escrow and receipts.",
  "license": "MIT",
  "author": "Young John",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deyoungjohn/kit.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/deyoungjohn/kit/tree/main/packages/mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./claude": {
      "types": "./dist/claude.d.ts",
      "import": "./dist/claude.js"
    },
    "./webmcp": {
      "types": "./dist/webmcp.d.ts",
      "import": "./dist/webmcp.js"
    },
    "./tools/policy": {
      "types": "./dist/tools/policy.d.ts",
      "import": "./dist/tools/policy.js"
    },
    "./tools/pay": {
      "types": "./dist/tools/pay.d.ts",
      "import": "./dist/tools/pay.js"
    },
    "./tools/receipts": {
      "types": "./dist/tools/receipts.d.ts",
      "import": "./dist/tools/receipts.js"
    },
    "./tools/evm": {
      "types": "./dist/tools/evm.d.ts",
      "import": "./dist/tools/evm.js"
    },
    "./tools/escrow": {
      "types": "./dist/tools/escrow.d.ts",
      "import": "./dist/tools/escrow.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "example:server": "tsx examples/mcp-server.ts",
    "example:agent": "tsx examples/agent.ts"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.130.0",
    "@codkit/contracts": "workspace:^",
    "@codkit/policy": "workspace:^",
    "@codkit/receipts": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "viem": "^2.48.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@codkit/contracts": {
      "optional": true
    },
    "@codkit/policy": {
      "optional": true
    },
    "@codkit/receipts": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "~0.133.0",
    "@codkit/contracts": "workspace:*",
    "@codkit/pay": "workspace:*",
    "@codkit/policy": "workspace:*",
    "@codkit/receipts": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "viem": "^2.48.0",
    "@x402/core": "~2.28.0",
    "hono": "^4.10.0"
  }
}
