{
  "name": "@codkit/pay",
  "version": "0.1.3",
  "description": "x402 payments for agents: paywall middleware (Hono / Express / MCP), a budget-aware client bounded by @codkit/policy, Solana x402, payment links, QR codes and signed webhooks.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "author": "Young John",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deyoungjohn/codkit.git",
    "directory": "packages/pay"
  },
  "homepage": "https://github.com/deyoungjohn/codkit/tree/main/packages/pay#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/core.d.ts",
        "default": "./dist/server/core.js"
      },
      "require": {
        "types": "./dist/server/core.d.cts",
        "default": "./dist/server/core.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/server/hono.d.ts",
        "default": "./dist/server/hono.js"
      },
      "require": {
        "types": "./dist/server/hono.d.cts",
        "default": "./dist/server/hono.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/server/express.d.ts",
        "default": "./dist/server/express.js"
      },
      "require": {
        "types": "./dist/server/express.d.cts",
        "default": "./dist/server/express.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp.d.ts",
        "default": "./dist/mcp.js"
      },
      "require": {
        "types": "./dist/mcp.d.cts",
        "default": "./dist/mcp.cjs"
      }
    },
    "./svm": {
      "import": {
        "types": "./dist/svm.d.ts",
        "default": "./dist/svm.js"
      },
      "require": {
        "types": "./dist/svm.d.cts",
        "default": "./dist/svm.cjs"
      }
    },
    "./links": {
      "import": {
        "types": "./dist/links.d.ts",
        "default": "./dist/links.js"
      },
      "require": {
        "types": "./dist/links.d.cts",
        "default": "./dist/links.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "example:server": "tsx --env-file-if-exists=../../.env examples/server.ts",
    "example:client": "tsx --env-file-if-exists=../../.env examples/client.ts",
    "example:local": "tsx --env-file-if-exists=../../.env examples/local.ts",
    "example:links": "tsx --env-file-if-exists=../../.env examples/links.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@codkit/policy": "workspace:^",
    "@x402/core": "~2.28.0",
    "@x402/evm": "~2.28.0",
    "@x402/fetch": "~2.28.0",
    "uqr": "~0.1.3"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@solana/kit": ">=5.1.0",
    "@x402/express": "~2.28.0",
    "@x402/hono": "~2.28.0",
    "@x402/mcp": "~2.28.0",
    "@x402/svm": "~2.28.0",
    "express": "^4.21.0 || ^5.0.0",
    "hono": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@x402/mcp": {
      "optional": true
    },
    "@x402/svm": {
      "optional": true
    },
    "@solana/kit": {
      "optional": true
    },
    "@x402/express": {
      "optional": true
    },
    "@x402/hono": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@solana/kit": "^8.4.0",
    "@types/express": "^5.0.0",
    "@x402/express": "~2.28.0",
    "@x402/hono": "~2.28.0",
    "@x402/mcp": "~2.28.0",
    "@x402/svm": "~2.28.0",
    "express": "^5.1.0",
    "hono": "^4.10.0",
    "viem": "^2.48.0",
    "zod": "^4.6.7"
  }
}
