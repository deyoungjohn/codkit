{
  "name": "@codkit/policy",
  "version": "0.1.1",
  "description": "Chain-agnostic guardrails for AI agents that move money: spend caps, allow/deny lists, human approval, mandatory simulation, kill switch.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "author": "Young John",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deyoungjohn/codkit.git",
    "directory": "packages/policy"
  },
  "homepage": "https://github.com/deyoungjohn/codkit/tree/main/packages/policy#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./evm": {
      "import": {
        "types": "./dist/adapters/evm.d.ts",
        "default": "./dist/adapters/evm.js"
      },
      "require": {
        "types": "./dist/adapters/evm.d.cts",
        "default": "./dist/adapters/evm.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "example": "tsx --env-file-if-exists=../../.env examples/basic.ts",
    "example:evm": "tsx --env-file-if-exists=../../.env examples/evm.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "viem": "^2.48.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "viem": "^2.48.0"
  }
}
