{
  "name": "@codkit/receipts",
  "version": "0.1.0",
  "description": "Verifiable receipts for agent actions: hash-chained, signed action log anchored onchain (EVM / Solana memo / Sui) with the full log on Walrus.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "author": "Young John",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deyoungjohn/codkit.git",
    "directory": "packages/receipts"
  },
  "homepage": "https://github.com/deyoungjohn/codkit/tree/main/packages/receipts#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./evm": {
      "import": {
        "types": "./dist/anchors/evm.d.ts",
        "default": "./dist/anchors/evm.js"
      },
      "require": {
        "types": "./dist/anchors/evm.d.cts",
        "default": "./dist/anchors/evm.cjs"
      }
    },
    "./solana": {
      "import": {
        "types": "./dist/anchors/solana.d.ts",
        "default": "./dist/anchors/solana.js"
      },
      "require": {
        "types": "./dist/anchors/solana.d.cts",
        "default": "./dist/anchors/solana.cjs"
      }
    },
    "./sui": {
      "import": {
        "types": "./dist/anchors/sui.d.ts",
        "default": "./dist/anchors/sui.js"
      },
      "require": {
        "types": "./dist/anchors/sui.d.cts",
        "default": "./dist/anchors/sui.cjs"
      }
    },
    "./walrus": {
      "import": {
        "types": "./dist/anchors/walrus.d.ts",
        "default": "./dist/anchors/walrus.js"
      },
      "require": {
        "types": "./dist/anchors/walrus.d.cts",
        "default": "./dist/anchors/walrus.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "example": "tsx --env-file-if-exists=../../.env examples/agent-log.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0"
  },
  "peerDependencies": {
    "@codkit/policy": "workspace:^",
    "@mysten/sui": "^2.0.0",
    "viem": "^2.48.0"
  },
  "peerDependenciesMeta": {
    "@codkit/policy": {
      "optional": true
    },
    "@mysten/sui": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codkit/contracts": "workspace:*",
    "@codkit/policy": "workspace:*",
    "@mysten/sui": "^2.36.0",
    "viem": "^2.48.0"
  }
}
