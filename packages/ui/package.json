{
  "name": "@codkit/ui",
  "version": "0.1.2",
  "description": "Dapp UI for @codkit/wallet: ConnectButton, AddressPill, ChainSwitcher, TokenAmountInput, TxStatusToast. Import them or copy a file in.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "author": "Young John",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deyoungjohn/codkit.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/deyoungjohn/codkit/tree/main/packages/ui#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@codkit/config": "workspace:^"
  },
  "peerDependencies": {
    "@codkit/wallet": "workspace:^",
    "react": ">=18"
  },
  "devDependencies": {
    "@codkit/wallet": "workspace:^",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
