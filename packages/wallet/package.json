{
  "name": "@codkit/wallet",
  "version": "0.2.0",
  "description": "One useWallet() for EVM and Solana dapps: hand-wired wagmi + Wallet Standard adapters, one swappable file per ecosystem.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "author": "Young John",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deyoungjohn/codkit.git",
    "directory": "packages/wallet"
  },
  "homepage": "https://github.com/deyoungjohn/codkit/tree/main/packages/wallet#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./evm": {
      "import": {
        "types": "./dist/evm.d.ts",
        "default": "./dist/evm.js"
      },
      "require": {
        "types": "./dist/evm.d.cts",
        "default": "./dist/evm.cjs"
      }
    },
    "./solana": {
      "import": {
        "types": "./dist/solana.d.ts",
        "default": "./dist/solana.js"
      },
      "require": {
        "types": "./dist/solana.d.cts",
        "default": "./dist/solana.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@codkit/config": "workspace:^",
    "@solana/wallet-standard-features": "^1.5.0",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1"
  },
  "peerDependencies": {
    "@solana/kit": ">=5.0.0",
    "@tanstack/react-query": "^5.0.0",
    "react": ">=18",
    "viem": "^2.48.0",
    "wagmi": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@solana/kit": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "viem": {
      "optional": true
    },
    "wagmi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solana-program/system": "^0.15.0",
    "@solana/kit": "^8.0.0",
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.20",
    "wagmi": "^3.0.0"
  }
}
